##Bouqet Builder App

##Seed class
class Seed:
##The class that would be the blueprint for the seed object

    """
    Constructor for the class that would include information stored about the seed:
    -seed type
    -price
    -if purchased
    """
    def __init__(self, seed_type, bloom_water, death_water, price, purchased):
        self.seed_type = seed_type
        self.bloom_water = bloom_water
        self.death_water = death_water
        self.price = price
        self.purchased = purchased

    """
    No methods as the seed does not the have ability to carry out actions
    """
